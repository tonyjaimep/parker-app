{
  "expo": {
    "name": "Parker",
    "slug": "parker-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "unstable_reactLegacyComponentNames": [
        "AIRMap",
        "AIRMapCallout",
        "AIRMapCalloutSubview",
        "AIRMapCircle",
        "AIRMapHeatmap",
        "AIRMapLocalTile",
        "AIRMapMarker",
        "AIRMapOverlay",
        "AIRMapPolygon",
        "AIRMapPolyline",
        "AIRMapUrlTile",
        "AIRMapWMSTile",
        "AIRMap",
        "AIRMapCallout",
        "AIRMapCalloutSubview",
        "AIRMapCircle",
        "AIRMapHeatmap",
        "AIRMapLocalTile",
        "AIRMapMarker",
        "AIRMapOverlay",
        "AIRMapPolygon",
        "AIRMapPolyline",
        "AIRMapUrlTile",
        "AIRMapWMSTile"
      ],
      "bundleIdentifier": "com.anonymous.parker-app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "unstable_reactLegacyComponentNames": [
        "AIRMap",
        "AIRMapCallout",
        "AIRMapCalloutSubview",
        "AIRMapCircle",
        "AIRMapHeatmap",
        "AIRMapLocalTile",
        "AIRMapMarker",
        "AIRMapOverlay",
        "AIRMapPolygon",
        "AIRMapPolyline",
        "AIRMapUrlTile",
        "AIRMapWMSTile",
        "AIRMap",
        "AIRMapCallout",
        "AIRMapCalloutSubview",
        "AIRMapCircle",
        "AIRMapHeatmap",
        "AIRMapLocalTile",
        "AIRMapMarker",
        "AIRMapOverlay",
        "AIRMapPolygon",
        "AIRMapPolyline",
        "AIRMapUrlTile",
        "AIRMapWMSTile"
      ],
      "package": "com.anonymous.parkerapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
